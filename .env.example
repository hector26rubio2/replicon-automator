# ============================================
# Replicon Automator — Environment Variables
# ============================================
# Copy to .env.development or .env.production and fill in real values.
# NEVER commit real credentials to version control.

# -------- Replicon Config --------
REPLICON_LOGIN_URL=https://flyr.okta.com/app/UserHome?type_hint=ACTIVATION&session_hint=AUTHENTICATED
REPLICON_TIMEOUT=45000
REPLICON_HEADLESS=false
REPLICON_AUTOSAVE=true

# -------- Supabase --------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# -------- GitHub (for auto-update & releases) --------
GH_TOKEN=ghp_your_token_here

# -------- Render (for backend deploy hook) --------
RENDER_API_KEY=your-render-api-key-here

# -------- Apple Signing (macOS builds — optional) --------
# APPLE_ID=your-apple-id@email.com
# APPLE_PASSWORD=your-app-specific-password
# APPLE_TEAM_ID=your-team-id

# -------- .NET Backend (Render runtime) --------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:10000